+# --- MTC-1.0 B2 self-config: read ~/.config/hg/edge.conf + edge_token as DATA ---
+# The supervisor spawns this file WITHOUT exporting HG_EDGE_*, which made the tunnel
+# exit immediately. Load config here as plain data (never source/eval) so the tunnel
+# runs with the intended device/edge/token.
+import pathlib as _pathlib
+_CF = _pathlib.Path(os.path.expanduser("~/.config/hg/edge.conf"))
+_TKF = _pathlib.Path(os.path.expanduser("~/.config/hg/edge_token"))
+def _cfgd(k):
+    try:
+        for _ln in _CF.read_text(errors="replace").splitlines():
+            _ln = _ln.strip()
+            if _ln.startswith(k + "="):
+                return _ln.split("=", 1)[1].strip()
+    except OSError:
+        pass
+    return ""
+if not (E.get("HG_EDGE_URL") or E.get("HG_TUNNEL_URL")):
+    _u = _cfgd("HG_EDGE_URL")
+    if _u: os.environ["HG_EDGE_URL"] = _u
+if not E.get("HG_EDGE_DEVICE"):
+    _d = _cfgd("HG_EDGE_DEVICE")
+    if _d: os.environ["HG_EDGE_DEVICE"] = _d
+if not E.get("HG_EDGE_TOKEN_FILE") and _TKF.exists():
+    os.environ["HG_EDGE_TOKEN_FILE"] = str(_TKF)
 EDGE = (E.get("HG_EDGE_URL") or E.get("HG_TUNNEL_URL") or "").rstrip("/")
